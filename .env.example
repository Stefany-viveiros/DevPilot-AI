# Optional. Defaults to a SQLite database in backend/data/devpilot.db.
DEVPILOT_DATABASE_URL=sqlite:///./data/devpilot.db
DEVPILOT_APP_NAME=DevPilot AI

# SaaS: habilite apenas atrás de HTTPS e proxy seguro.
DEVPILOT_AUTH_REQUIRED=false
# Gere um segredo aleatório com pelo menos 32 caracteres antes de habilitar autenticação.
DEVPILOT_AUTH_SECRET=
DEVPILOT_OLLAMA_URL=http://127.0.0.1:11434
DEVPILOT_OLLAMA_MODEL=qwen2.5-coder:3b
